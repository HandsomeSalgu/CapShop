# ==================== 🔴 필수 환경변수 (MUST SET) ====================
# 빈값이면 애플리케이션 부팅 실패!

# OAuth2 Redirect URIs (환경에 맞게 변경)
# 로컬: http://localhost:5173, http://localhost:8080
# AWS: https://capshop.com, https://api.capshop.com
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback
OAUTH2_SIGNUP_REDIRECT_URI=http://localhost:5173/signup
OAUTH2_GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
OAUTH2_KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# JWT Secret (반드시 32자 이상의 강력한 문자열!)
JWT_SECRET=your-secure-random-32plus-character-jwt-secret-key

# ==================== OAuth & External Services ====================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ==================== Email Service ====================
SPRING_MAIL_USERNAME=your-gmail@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# ==================== CORS Allowed Origins ====================
# 로컬 개발: localhost 허용
# 운영: CloudFront 도메인만 허용 (보안!)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== Database ====================
# 로컬: docker-compose에서 관리 (기본: root/potato)
# 운영: RDS 사용 시 설정
DB_USERNAME=root
DB_PASSWORD=potato

# ==================== AI Service Settings ====================
AI_FASTAPI_TIMEOUT_MS=180000
