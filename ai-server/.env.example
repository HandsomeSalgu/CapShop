# ==================== AI Detection Provider ====================
AI_DETECTION_PROVIDER=gemini  # 운영: gemini, 개발: mock
GEMINI_API_KEY=your-gemini-api-key

# ==================== Google Custom Search Engine ====================
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_CX=your-search-engine-id

# ==================== Backend Connection ====================
# EC2 docker-compose: http://backend:8000
# 로컬: http://localhost:8080
BACKEND_BASE_URL=http://backend:8080

# ==================== Database (EC2 내부 MySQL) ====================
# docker-compose 호스트명 사용
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=potato
DB_NAME=syncshopper

# ==================== Advanced AI Settings (선택) ====================
# AI 모델 커스터마이징
