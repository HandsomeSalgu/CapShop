# ===== application.yml 수정 가이드 =====
# 현재 backend/src/main/resources/application.yml의 다음 항목들을 수정합니다:

# === 변경 전 (현재, 로컬 dev용) ===
spring:
  profiles:
    active: local  # <- 이 부분을 환경변수로 변경

  security:
    oauth2:
      client:
        registration:
          google:
            redirect-uri: ${OAUTH2_GOOGLE_REDIRECT_URI:http://70.12.60.52:8080/login/oauth2/code/google}  # <- 기본값에 하드코딩 IP
          kakao:
            redirect-uri: ${OAUTH2_KAKAO_REDIRECT_URI:http://70.12.60.52:8080/login/oauth2/code/kakao}  # <- 기본값에 하드코딩 IP

app:
  oauth2:
    authorized-redirect-uri: ${OAUTH2_REDIRECT_URI:http://70.12.60.52:5173/oauth/callback}  # <- 기본값에 하드코딩 IP
    signup-redirect-uri: ${OAUTH2_SIGNUP_REDIRECT_URI:http://70.12.60.52:5173/signup}  # <- 기본값에 하드코딩 IP


# === 변경 후 (프로덕션 준비) ===
spring:
  profiles:
    active: ${SPRING_PROFILES_ACTIVE:local}  # 환경변수로 지정, 기본값 local

  security:
    oauth2:
      client:
        registration:
          google:
            # 기본값 제거 - 반드시 환경변수 지정 필수
            redirect-uri: ${OAUTH2_GOOGLE_REDIRECT_URI}
          kakao:
            # 기본값 제거 - 반드시 환경변수 지정 필수
            redirect-uri: ${OAUTH2_KAKAO_REDIRECT_URI}

app:
  oauth2:
    # 기본값 제거 - 반드시 환경변수 지정 필수
    authorized-redirect-uri: ${OAUTH2_REDIRECT_URI}
    signup-redirect-uri: ${OAUTH2_SIGNUP_REDIRECT_URI}


# ===== 환경변수 주입 예시 =====
# AWS EC2 배포 시, 다음과 같이 환경변수 설정:

SPRING_PROFILES_ACTIVE=prod
OAUTH2_GOOGLE_REDIRECT_URI=https://your-domain.com/login/oauth2/code/google
OAUTH2_KAKAO_REDIRECT_URI=https://your-domain.com/login/oauth2/code/kakao
OAUTH2_REDIRECT_URI=https://your-domain.com/oauth/callback
OAUTH2_SIGNUP_REDIRECT_URI=https://your-domain.com/signup

# 이 환경변수들을 EC2 환경에 설정하는 방법:
# 1. backend/.env 파일에 작성
# 2. docker compose up 시 자동으로 .env를 읽음
# 3. 또는 docker run -e SPRING_PROFILES_ACTIVE=prod ... 로 직접 주입


# ===== 실제 수정 단계 =====
# 1. backend/src/main/resources/application.yml 열기
# 2. 위의 "변경 후" 부분대로 수정
# 3. Maven 빌드: cd backend && ./mvnw clean package
# 4. EC2에 배포 시 backend/.env에 환경변수 설정
# 5. docker compose up -d로 실행
